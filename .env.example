# ==============================================================================
# UrbanPulse NEXUS — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your local credentials and API keys.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Database Configuration (Local MySQL 8.0)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=urbanpulse

# TomTom Traffic API Configuration (Real-World Corridor Telemetry)
# Obtain your free API key at: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here
API_TIMEOUT_SECONDS=10
API_MAX_RETRIES=3

# Open-Meteo REST API Configuration (No API Key Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AQ_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Apache Kafka Event Streaming (Local / Docker KRaft)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRAFFIC_TOPIC=urbanpulse.traffic.raw
KAFKA_IOT_TOPIC=urbanpulse.iot.raw

# Arduino Hardware Serial Gateway Configuration (Physical Edge IoT Lab)
ARDUINO_PORT=AUTO
ARDUINO_BAUD_RATE=9600

# Mobility Simulation Settings (Legacy / Fallback)
SIMULATOR_FREQUENCY_SECONDS=2
SIMULATOR_NUM_SEGMENTS=15

# Local Storage Directory Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REJECTED_DATA_DIR=data/rejected

